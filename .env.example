PORT=5000
NODE_ENV=development

# Same database as studynook-client (Better Auth)
# Local: mongodb://127.0.0.1:27017
# Atlas (Windows): prefer mongodb:// with shard hostnames if mongodb+srv fails (querySrv ECONNREFUSED)
MONGODB_URI=mongodb://USER:PASS@cluster0-shard-00-00.xxxxx.mongodb.net:27017,cluster0-shard-00-01.xxxxx.mongodb.net:27017,cluster0-shard-00-02.xxxxx.mongodb.net:27017/StudyNook?ssl=true&authSource=admin&retryWrites=true&w=majority
MONGODB_DB_NAME=StudyNook

# Must match studynook-client BETTER_AUTH_SECRET (Express verifies Next set-token JWT)
JWT_SECRET=your-secret-key
BETTER_AUTH_SECRET=your-secret-key
# Optional on client; Express reads cookie name "token" (httpOnly)

# Next.js origin (for CORS + credentials)
CLIENT_URL=http://localhost:3000
