PORT=5000
NODE_ENV=development

# Same database as studynook-client (Better Auth)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=StudyNook

# Must match studynook-client BETTER_AUTH_SECRET (or set JWT_SECRET explicitly)
JWT_SECRET=your-secret-key
BETTER_AUTH_SECRET=your-secret-key

# Next.js origin (for CORS + credentials)
CLIENT_URL=http://localhost:3000
